        }
      ],
      "Replication": "Disabled",
      "Description": "Alle integrierten Kategorien"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0]: Liste (ggf. verschachtelt) von Revit-Element-Instanzen (keine IDs/Types)\r\nimport clr, math\r\nclr.AddReference(\"RevitAPI\"); from Autodesk.Revit.DB import *\r\nclr.AddReference(\"RevitServices\"); from RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nclr.AddReference(\"ProtoGeometry\"); from Autodesk.DesignScript.Geometry import Point as DSPt\r\n\r\n# Optional: Dynamo-Wrapper laden\r\ntry:\r\n    clr.AddReference(\"RevitNodes\"); import Revit\r\nexcept:\r\n    pass\r\n\r\n# ---------- Utilities ----------\r\ndef flatten(x):\r\n    if isinstance(x, list):\r\n        r=[]; [r.extend(flatten(i)) for i in x]; return r\r\n    return [x]\r\n\r\ndef to_db(el):\r\n    # Dynamo-Wrapper -> DB.Element\r\n    try:\r\n        ie = el.InternalElement\r\n        if isinstance(ie, Element): return ie\r\n    except: pass\r\n    try:\r\n        ue = UnwrapElement(el)\r\n        if isinstance(ue, Element): return ue\r\n    except: pass\r\n    return el if isinstance(el, Element) else None\r\n\r\ndef dpt_xyz(xyz): return DSPt.ByCoordinates(xyz.X, xyz.Y, xyz.Z)\r\n\r\ndef midpoint(e):\r\n    # 1) FamilyInstance: Transform-Origin (zuverlässig, Welt-KOS)\r\n    if isinstance(e, FamilyInstance):\r\n        try:\r\n            tr = e.GetTransform()\r\n            if tr:\r\n                o = tr.Origin\r\n                if abs(o.X)+abs(o.Y)+abs(o.Z) > 1e-8:\r\n                    return dpt_xyz(o)\r\n        except: pass\r\n    # 2) Location\r\n    try:\r\n        loc = e.Location\r\n        if isinstance(loc, LocationPoint):\r\n            p = loc.Point\r\n            if abs(p.X)+abs(p.Y)+abs(p.Z) > 1e-8:\r\n                return dpt_xyz(p)\r\n        elif isinstance(loc, LocationCurve):\r\n            mp = loc.Curve.Evaluate(0.5, True)\r\n            return dpt_xyz(mp)\r\n    except: pass\r\n    # 3) BoundingBox (global)\r\n    try:\r\n        bb = e.get_BoundingBox(None)\r\n        if bb:\r\n            return DSPt.ByCoordinates((bb.Min.X+bb.Max.X)/2.0,\r\n                                      (bb.Min.Y+bb.Max.Y)/2.0,\r\n                                      (bb.Min.Z+bb.Max.Z)/2.0)\r\n    except: pass\r\n    # 4) Solids-Centroid (view-unabhängig)\r\n    try:\r\n        opts = Options(); opts.DetailLevel = ViewDetailLevel.Fine; opts.IncludeNonVisibleObjects = True\r\n        ge = e.get_Geometry(opts)\r\n        solids=[]\r\n        if ge:\r\n            for g in ge:\r\n                if isinstance(g, Solid) and g.Volume > 1e-9: solids.append(g)\r\n                elif isinstance(g, GeometryInstance):\r\n                    for gi in g.GetInstanceGeometry():\r\n                        if isinstance(gi, Solid) and gi.Volume > 1e-9: solids.append(gi)\r\n        if solids:\r\n            V=cx=cy=cz=0.0\r\n            for s in solids:\r\n                try:\r\n                    c = s.ComputeCentroid()\r\n                except:\r\n                    bb = s.GetBoundingBox()\r\n                    if not bb: continue\r\n                    c = XYZ((bb.Min.X+bb.Max.X)/2.0,(bb.Min.Y+bb.Max.Y)/2.0,(bb.Min.Z+bb.Max.Z)/2.0)\r\n                v = max(s.Volume,0.0)\r\n                if v<=0: continue\r\n                V+=v; cx+=c.X*v; cy+=c.Y*v; cz+=c.Z*v\r\n            if V>0:\r\n                return DSPt.ByCoordinates(cx/V, cy/V, cz/V)\r\n    except: pass\r\n    return DSPt.ByCoordinates(0,0,0)\r\n\r\ndef _norm(v):\r\n    m = math.sqrt(v.X*v.X + v.Y*v.Y + v.Z*v.Z)\r\n    if m < 1e-12: return None\r\n    return XYZ(v.X/m, v.Y/m, v.Z/m)\r\n\r\ndef _euler_zyx_from_bases(bx, by, bz):\r\n    # R = [bx by bz] (Basen in Welt), Euler Z-Y-X → (YawZ, PitchY, RollX) in Grad\r\n    r11, r21, r31 = bx.X, bx.Y, bx.Z\r\n    r12, r22, r32 = by.X, by.Y, by.Z\r\n    r13, r23, r33 = bz.X, bz.Y, bz.Z\r\n    r31 = max(min(r31, 1.0), -1.0)\r\n    pitch = math.asin(-r31)\r\n    cp = math.cos(pitch)\r\n    if abs(cp) > 1e-10:\r\n        roll  = math.atan2(r32, r33)\r\n        yaw   = math.atan2(r21, r11)\r\n    else:\r\n        roll  = 0.0\r\n        yaw   = math.atan2(-r12, r22)\r\n    def deg(a):\r\n        d = math.degrees(a) % 360.0\r\n        if d < 0: d += 360.0\r\n        return d\r\n    return deg(yaw), deg(pitch), deg(roll)\r\n\r\ndef rotation_ypr_with_source(e):\r\n    \"\"\"\r\n    Rotation relativ zum Welt-KOS:\r\n    1) Wenn Transform vorhanden: Basen → Euler Z-Y-X (Yaw/Pitch/Roll)\r\n    2) Sonst bei LocationCurve: Tangente + stabile Up-Achse → Basen → Euler\r\n    3) Sonst 0/0/0\r\n    \"\"\"\r\n    # 1) Transform (z. B. FamilyInstance, einige Systeminstanzen)\r\n    try:\r\n        # FamilyInstance sicher, aber manche andere Elemente haben auch GetTransform()\r\n        tr = e.GetTransform() if hasattr(e, \"GetTransform\") else None\r\n        if tr:\r\n            bx = _norm(tr.BasisX); by = _norm(tr.BasisY); bz = _norm(tr.BasisZ)\r\n            if bx and by and bz:\r\n                y,p,r = _euler_zyx_from_bases(bx, by, bz)\r\n                return y,p,r,\"Transform\"\r\n    except:\r\n        pass\r\n\r\n    # 2) Kurvenbasierte Elemente (Rohre/Kanäle/Dämmung etc.)\r\n    try:\r\n        loc = e.Location\r\n        if isinstance(loc, LocationCurve):\r\n            t = _norm(loc.Curve.ComputeDerivatives(0.5, True).BasisX)  # lokale X\r\n            if t:\r\n                up = XYZ.BasisZ\r\n                # Falls Tangente ≈ parallel zu Z, auf Y ausweichen, um Gimbal-lock zu vermeiden\r\n                cross = XYZ(t.Y*up.Z - t.Z*up.Y, t.Z*up.X - t.X*up.Z, t.X*up.Y - t.Y*up.X)\r\n                if _norm(cross) is None or (abs(cross.X)+abs(cross.Y)+abs(cross.Z)) < 1e-6:\r\n                    up = XYZ.BasisY\r\n                    cross = XYZ(t.Y*up.Z - t.Z*up.Y, t.Z*up.X - t.X*up.Z, t.X*up.Y - t.Y*up.X)\r\n                bz = _norm(cross)                                     # lokale Z = t × up\r\n                by = _norm(XYZ(bz.Y*t.Z - bz.Z*t.Y, bz.Z*t.X - bz.X*t.Z, bz.X*t.Y - bz.Y*t.X))  # by = bz × t\r\n                bx = t                                                # lokale X = Tangente\r\n                if bx and by and bz:\r\n                    y,p,r = _euler_zyx_from_bases(bx, by, bz)\r\n                    return y,p,r,\"Curve\"\r\n    except:\r\n        pass\r\n\r\n    # 3) Fallback\r\n    return 0.0, 0.0, 0.0, \"Fallback\"\r\n\r\ndef ifc_guid(e):\r\n    # IFC GUID, sonst UniqueId\r\n    try:\r\n        from Autodesk.Revit.DB import ExporterIFCUtils\r\n        g = ExporterIFCUtils.CreateGUID(e.Id)\r\n        if g: return g\r\n    except: pass\r\n    for pname in (\"IFC GUID\",\"IfcGUID\",\"IFCGUID\",\"IFCGlobalId\"):\r\n        try:\r\n            p = e.LookupParameter(pname)\r\n            if p and p.StorageType == StorageType.String:\r\n                v = p.AsString()\r\n                if v: return v\r\n        except: pass\r\n    try: return e.UniqueId\r\n    except: return str(e.Id.IntegerValue)\r\n\r\n# ---------- Run ----------\r\nraw = flatten(IN[0])\r\ndb_elems = [to_db(x) for x in raw if x is not None and not isinstance(x, ElementType)]\r\n\r\nguids, points, yaws, pitchs, rolls, sources = [], [], [], [], [], []\r\nfor e in db_elems:\r\n    guids.append(ifc_guid(e))\r\n    points.append(midpoint(e))\r\n    y,p,r,src = rotation_ypr_with_source(e)\r\n    yaws.append(y); pitchs.append(p); rolls.append(r); sources.append(src)\r\n\r\nOUT = [guids, points, yaws, pitchs, rolls, sources]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "ea12c052114c4f1c94330ceaf37b6030",
      "NodeType": "PythonScriptNode",
      "Inputs": [
