    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0]: [[guid, Point, [yaw,pitch,roll], montage_idx] ...]  (optional 5. Feld: category)\r\n# IN[1]: optional: Ausgabepfad, z.B. r\"C:\\Temp\\montage.json\"\r\n# IN[2]: optional: indent (int), Default 2\r\n# IN[3]: optional: categories list (len == len(IN[0])) falls nicht als 5. Feld vorhanden\r\n\r\nimport clr, json, os\r\n\r\n# Revit/Dynamo\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point as DSPt\r\n\r\n# Popup\r\ntry:\r\n    clr.AddReference(\"RevitAPIUI\")\r\n    from Autodesk.Revit.UI import TaskDialog\r\n    _use_taskdialog = True\r\nexcept:\r\n    _use_taskdialog = False\r\ntry:\r\n    import System\r\n    from System.Windows.Forms import MessageBox\r\n    _use_winforms = True\r\nexcept:\r\n    _use_winforms = False\r\n\r\ndef _popup(msg, title=\"Export\"):\r\n    try:\r\n        if _use_taskdialog:\r\n            TaskDialog.Show(title, msg)\r\n            return\r\n    except:\r\n        pass\r\n    try:\r\n        if _use_winforms:\r\n            MessageBox.Show(msg, title)\r\n            return\r\n    except:\r\n        pass\r\n    # Fallback: nichts\r\n\r\ndef _is_point(p):\r\n    try: return isinstance(p, DSPt)\r\n    except: return False\r\n\r\ndef _to_float(x, nd=6):\r\n    try: return round(float(x), nd)\r\n    except: return None\r\n\r\nrows = IN[0] if isinstance(IN[0], list) else []\r\nout_path = IN[1] if (len(IN) > 1 and isinstance(IN[1], (str,))) else None\r\nindent = IN[2] if (len(IN) > 2 and isinstance(IN[2], int)) else 2\r\ncat_list = IN[3] if (len(IN) > 3 and isinstance(IN[3], list)) else None\r\n\r\nitems = []\r\nfor i, row in enumerate(rows):\r\n    if not isinstance(row, list) or len(row) < 4:\r\n        continue\r\n    guid = row[0]\r\n    pt   = row[1]\r\n    rot  = row[2] if (isinstance(row[2], list) and len(row[2]) >= 3) else [0.0, 0.0, 0.0]\r\n    idx  = row[3]\r\n    # Kategorie: erst 5. Feld, sonst IN[3], sonst \"\"\r\n    if len(row) >= 5 and isinstance(row[4], (str,)):\r\n        category = row[4]\r\n    elif cat_list and i < len(cat_list):\r\n        category = cat_list[i]\r\n    else:\r\n        category = \"\"\r\n\r\n    x = _to_float(pt.X) if _is_point(pt) else None\r\n    y = _to_float(pt.Y) if _is_point(pt) else None\r\n    z = _to_float(pt.Z) if _is_point(pt) else None\r\n\r\n    yaw   = _to_float(rot[0]); pitch = _to_float(rot[1]); roll = _to_float(rot[2])\r\n\r\n    items.append({\r\n        \"guid\": guid if guid is not None else \"\",\r\n        \"category\": category,\r\n        \"point\": {\"x\": x, \"y\": y, \"z\": z},\r\n        \"rotation\": {\"yaw\": yaw, \"pitch\": pitch, \"roll\": roll},\r\n        \"montage_index\": int(idx) if isinstance(idx, (int, float)) else None\r\n    })\r\n\r\npayload = {\"meta\": {\"count\": len(items)}, \"items\": items}\r\njson_text = json.dumps(payload, ensure_ascii=False, indent=indent, separators=(\",\", \": \"))\r\n\r\nwritten_path = None\r\nif out_path:\r\n    try:\r\n        folder = os.path.dirname(out_path)\r\n        if folder and not os.path.exists(folder):\r\n            os.makedirs(folder)\r\n        # Python 3: explizites UTF-8\r\n        with open(out_path, \"w\", encoding=\"utf-8\") as f:\r\n            f.write(json_text)\r\n        written_path = out_path\r\n        _popup(\"Export erfolgreich:\\n{}\".format(out_path), \"Montage-JSON\")\r\n    except Exception as ex:\r\n        _popup(\"Export fehlgeschlagen:\\n{}\".format(str(ex)), \"Montage-JSON\")\r\n        # bei Fehler trotzdem Text zurückgeben\r\n\r\nOUT = [json_text, written_path]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "6976ebf288f4488aa0745701fdde3a7b",
