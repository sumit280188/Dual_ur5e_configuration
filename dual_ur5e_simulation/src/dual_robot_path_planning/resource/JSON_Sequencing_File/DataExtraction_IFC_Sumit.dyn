    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 565,
      "SelectedString": "OST_PipeAccessory",
      "Id": "8cb1b4dcbd234db9a8f8fef25f4c9164",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "a401dab0f8864d4abc24e569dc932792",
          "Name": "Category",
          "Description": "Die ausgewählte Kategorie",
