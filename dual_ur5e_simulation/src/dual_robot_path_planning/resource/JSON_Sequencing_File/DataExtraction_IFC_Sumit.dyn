    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0]..IN[4]: je Kategorie ein Paket [guids, points, yaw, pitch, roll, (sources optional)]\r\n# OUT: eine Liste von Einträgen: [IFCGuid, Point, [Yaw,Pitch,Roll], Montagenummer, Kategorie]\r\n\r\nimport clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import Point as DSPt\r\n\r\ndef is_point(x):\r\n    try: return isinstance(x, DSPt)\r\n    except: return False\r\n\r\ndef get_pack(inp):\r\n    if not isinstance(inp, list) or len(inp) < 2:\r\n        return [], [], [], [], [], []\r\n    guids  = inp[0] if len(inp) > 0 else []\r\n    points = inp[1] if len(inp) > 1 else []\r\n    yaws   = inp[2] if len(inp) > 2 else []\r\n    pitchs = inp[3] if len(inp) > 3 else []\r\n    rolls  = inp[4] if len(inp) > 4 else []\r\n    srcs   = inp[5] if len(inp) > 5 else []\r\n    n = min(len(guids), len(points),\r\n            len(yaws) if yaws else len(points),\r\n            len(pitchs) if pitchs else len(points),\r\n            len(rolls) if rolls else len(points))\r\n    if not yaws:   yaws   = [0.0]*n\r\n    if not pitchs: pitchs = [0.0]*n\r\n    if not rolls:  rolls  = [0.0]*n\r\n    if not srcs:   srcs   = [\"\"]*n\r\n    return guids[:n], points[:n], yaws[:n], pitchs[:n], rolls[:n], srcs[:n]\r\n\r\n# Feste Eingangsreihenfolge\r\npacks = [IN[0] if len(IN)>0 else None,\r\n         IN[1] if len(IN)>1 else None,\r\n         IN[2] if len(IN)>2 else None,\r\n         IN[3] if len(IN)>3 else None,\r\n         IN[4] if len(IN)>4 else None]\r\n\r\n# Anzeigename je Eingang (➡️ hier bei Bedarf an dein Projekt anpassen)\r\ncat_label = {\r\n    0: \"Allgemeines Modell\",\r\n    1: \"Sonderausstattung\",\r\n    2: \"Rohrformteile\",\r\n    3: \"Rohre\",\r\n    4: \"Rohrzubehör\"\r\n}\r\n\r\n# Priorität: Sonderausstattung zuerst, dann 0,2,3,4\r\ncat_priority = {1:0, 0:1, 2:2, 3:3, 4:4}\r\n\r\nrecords = []\r\nfor ci, pk in enumerate(packs):\r\n    if pk is None: continue\r\n    guids, pts, yaws, pitchs, rolls, srcs = get_pack(pk)\r\n    label = cat_label.get(ci, \"\")\r\n    for i in range(len(guids)):\r\n        p = pts[i]\r\n        z = p.Z if is_point(p) and (p.Z is not None) else float('inf')\r\n        records.append({\r\n            \"prio\": cat_priority.get(ci, 99),\r\n            \"z\": z,\r\n            \"cat\": ci,\r\n            \"i\": i,\r\n            \"label\": label,\r\n            \"guid\": guids[i],\r\n            \"pt\": p,\r\n            \"y\": float(yaws[i]),\r\n            \"p\": float(pitchs[i]),\r\n            \"r\": float(rolls[i])\r\n        })\r\n\r\n# Sortierung: Kategorie-Priorität → Z → stabil\r\nrecords.sort(key=lambda r: (r[\"prio\"], r[\"z\"], r[\"cat\"], r[\"i\"]))\r\n\r\n# Montagenummern & Zieldaten: jetzt MIT Kategorie als 5. Feld\r\nout_list = []\r\nfor idx, r in enumerate(records, start=1):\r\n    out_list.append([ r[\"guid\"], r[\"pt\"], [r[\"y\"], r[\"p\"], r[\"r\"]], idx, r[\"label\"] ])\r\n\r\nOUT = out_list\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "00cf0b32e00a49f1820371b3eb38efd2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e8f515d2b52b41bcbc427ec26f511307",
          "Name": "IN[0]",
          "Description": "Input #0",
