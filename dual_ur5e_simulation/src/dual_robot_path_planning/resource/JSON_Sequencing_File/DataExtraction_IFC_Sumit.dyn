    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 552,
      "SelectedString": "OST_PipeCurves",
      "Id": "e250b2cd80f1441d8db97acc757ce2b0",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "3dc39ce897de439e92c79e505199cf9b",
          "Name": "Category",
          "Description": "Die ausgewählte Kategorie",
          "UsingDefaultValue": false,
          "Level": 2,
