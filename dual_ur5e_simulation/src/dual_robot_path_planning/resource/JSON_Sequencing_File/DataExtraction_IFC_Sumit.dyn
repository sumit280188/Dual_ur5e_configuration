          "Name": "OUT",
          "Description": "Ergebnis des Python-Skripts",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Führt ein eingebettetes Python-Skript aus."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0]: Liste (ggf. verschachtelt) von Revit-Element-Instanzen\r\nimport clr, math, sys\r\nclr.AddReference(\"RevitAPI\"); from Autodesk.Revit.DB import *\r\nclr.AddReference(\"RevitServices\"); from RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nclr.AddReference(\"ProtoGeometry\"); from Autodesk.DesignScript.Geometry import Point as DSPt\r\n\r\n# optional: Dynamo-Wrapper\r\ntry:\r\n    clr.AddReference(\"RevitNodes\"); import Revit\r\nexcept:\r\n    pass\r\n\r\n# -------- helpers ----------\r\ndef flatten(x):\r\n    if isinstance(x, list):\r\n        out = []\r\n        for i in x:\r\n            out.extend(flatten(i))\r\n        return out\r\n    return [x]\r\n\r\ndef to_db(el):\r\n    # Dynamo Wrapper -> DB.Element\r\n    try:\r\n        ie = el.InternalElement\r\n        if isinstance(ie, Element): return ie\r\n    except: pass\r\n    try:\r\n        ue = UnwrapElement(el)\r\n        if isinstance(ue, Element): return ue\r\n    except: pass\r\n    if isinstance(el, Element): return el\r\n    return None\r\n\r\ndef pt_xyz(xyz):\r\n    return DSPt.ByCoordinates(xyz.X, xyz.Y, xyz.Z)\r\n\r\ndef midpoint(e):\r\n    # 1) FamilyInstance.Transform.Origin\r\n    if isinstance(e, FamilyInstance):\r\n        try:\r\n            tr = e.GetTransform()\r\n            if tr:\r\n                o = tr.Origin\r\n                if abs(o.X)+abs(o.Y)+abs(o.Z) > 1e-8:\r\n                    return pt_xyz(o)\r\n        except: pass\r\n    # 2) Location\r\n    try:\r\n        loc = e.Location\r\n        if isinstance(loc, LocationPoint):\r\n            p = loc.Point\r\n            if abs(p.X)+abs(p.Y)+abs(p.Z) > 1e-8:\r\n                return pt_xyz(p)\r\n        elif isinstance(loc, LocationCurve):\r\n            mp = loc.Curve.Evaluate(0.5, True)\r\n            return pt_xyz(mp)\r\n    except: pass\r\n    # 3) BoundingBox (global)\r\n    try:\r\n        bb = e.get_BoundingBox(None)\r\n        if bb:\r\n            return DSPt.ByCoordinates((bb.Min.X+bb.Max.X)/2.0,\r\n                                      (bb.Min.Y+bb.Max.Y)/2.0,\r\n                                      (bb.Min.Z+bb.Max.Z)/2.0)\r\n    except: pass\r\n    # 4) Solids-Centroid (view-unabhängig)\r\n    try:\r\n        opts = Options(); opts.DetailLevel = ViewDetailLevel.Fine; opts.IncludeNonVisibleObjects = True\r\n        ge = e.get_Geometry(opts)\r\n        solids=[]\r\n        if ge:\r\n            for g in ge:\r\n                if isinstance(g, Solid) and g.Volume > 1e-9: solids.append(g)\r\n                elif isinstance(g, GeometryInstance):\r\n                    for gi in g.GetInstanceGeometry():\r\n                        if isinstance(gi, Solid) and gi.Volume > 1e-9: solids.append(gi)\r\n        if solids:\r\n            V=cx=cy=cz=0.0\r\n            for s in solids:\r\n                try:\r\n                    c = s.ComputeCentroid()\r\n                except:\r\n                    bb = s.GetBoundingBox()\r\n                    if not bb: continue\r\n                    c = XYZ((bb.Min.X+bb.Max.X)/2.0,(bb.Min.Y+bb.Max.Y)/2.0,(bb.Min.Z+bb.Max.Z)/2.0)\r\n                v = max(s.Volume,0.0)\r\n                if v<=0: continue\r\n                V+=v; cx+=c.X*v; cy+=c.Y*v; cz+=c.Z*v\r\n            if V>0:\r\n                return DSPt.ByCoordinates(cx/V, cy/V, cz/V)\r\n    except: pass\r\n    return DSPt.ByCoordinates(0,0,0)\r\n\r\ndef ang_deg(a):\r\n    d = math.degrees(a) % 360.0\r\n    if d < 0: d += 360.0\r\n    return d\r\n\r\ndef rotation_ypr_with_source(e):\r\n    \"\"\"Yaw (Z), Pitch (Y), Roll (X) in Grad + source string\"\"\"\r\n    yaw = pitch = roll = 0.0\r\n    src = []\r\n\r\n    tr = None\r\n    try:\r\n        if isinstance(e, FamilyInstance):\r\n            tr = e.GetTransform()\r\n    except:\r\n        tr = None\r\n\r\n    # Yaw-Kandidaten\r\n    yaw_candidates = []\r\n    # LP.Rotation (um Z, Radiant)\r\n    try:\r\n        loc = e.Location\r\n        if isinstance(loc, LocationPoint):\r\n            yaw_lp = ang_deg(loc.Rotation)\r\n            yaw_candidates.append((\"LP.Rotation\", yaw_lp))\r\n    except:\r\n        pass\r\n    # Facing/Hand\r\n    try:\r\n        if isinstance(e, FamilyInstance):\r\n            fv = e.FacingOrientation\r\n            yaw_fv = ang_deg(math.atan2(fv.Y, fv.X))\r\n            yaw_candidates.append((\"FI.Facing\", yaw_fv))\r\n    except:\r\n        pass\r\n    try:\r\n        if isinstance(e, FamilyInstance):\r\n            hv = e.HandOrientation\r\n            yaw_hv = ang_deg(math.atan2(hv.Y, hv.X))\r\n            yaw_candidates.append((\"FI.Hand\", yaw_hv))\r\n    except:\r\n        pass\r\n    # Transform\r\n    try:\r\n        if tr:\r\n            yaw_tr = ang_deg(math.atan2(tr.BasisX.Y, tr.BasisX.X))\r\n            yaw_candidates.append((\"FI.Transform\", yaw_tr))\r\n    except:\r\n        pass\r\n    # Kurvenrichtung\r\n    try:\r\n        loc2 = e.Location\r\n        if isinstance(loc2, LocationCurve):\r\n            dv = loc2.Curve.ComputeDerivatives(0.5, True).BasisX\r\n            yaw_cv = ang_deg(math.atan2(dv.Y, dv.X))\r\n            yaw_candidates.append((\"Curve.Tangent\", yaw_cv))\r\n    except:\r\n        pass\r\n\r\n    if yaw_candidates:\r\n        order = {\"LP.Rotation\":0, \"FI.Facing\":1, \"FI.Hand\":2, \"FI.Transform\":3, \"Curve.Tangent\":4}\r\n        yaw_candidates.sort(key=lambda t: order.get(t[0], 99))\r\n        yaw = yaw_candidates[0][1]\r\n        src.append(yaw_candidates[0][0])\r\n    else:\r\n        src.append(\"Yaw:0\")\r\n\r\n    # Pitch: aus BasisZ (Transform) oder Kurventangente\r\n    try:\r\n        if tr:\r\n            bz = tr.BasisZ\r\n            bzZ = max(min(bz.Z, 1.0), -1.0)\r\n            # Neigung gg. Welt-Z\r\n            pitch = ang_deg(math.acos(bzZ))\r\n            src.append(\"Pitch:Tr.BasisZ\")\r\n        else:\r\n            if isinstance(e.Location, LocationCurve):\r\n                dv = e.Location.Curve.ComputeDerivatives(0.5, True).BasisX\r\n                horiz = math.sqrt(dv.X*dv.X + dv.Y*dv.Y)\r\n                pitch = ang_deg(math.atan2(-dv.Z, horiz))\r\n                src.append(\"Pitch:Tangent\")\r\n    except:\r\n        src.append(\"Pitch:0\")\r\n\r\n    # Roll: aus BasisX relativ zu BasisZ\r\n    try:\r\n        if tr:\r\n            bx = tr.BasisX; bz = tr.BasisZ\r\n            dot = bx.X*bz.X + bx.Y*bz.Y + bx.Z*bz.Z\r\n            projX = XYZ(bx.X - dot*bz.X, bx.Y - dot*bz.Y, bx.Z - dot*bz.Z)\r\n            m = math.sqrt(projX.X**2 + projX.Y**2 + projX.Z**2)\r\n            if m > 1e-9:\r\n                ux = XYZ(projX.X/m, projX.Y/m, projX.Z/m)\r\n                # Referenz: Welt-X auf Ebene ⟂ bz projiziert\r\n                dotWX = bz.X\r\n                ref = XYZ(1.0 - dotWX*bz.X, 0.0 - dotWX*bz.Y, 0.0 - dotWX*bz.Z)\r\n                mr = math.sqrt(ref.X**2 + ref.Y**2 + ref.Z**2)\r\n                if mr > 1e-9:\r\n                    ur = XYZ(ref.X/mr, ref.Y/mr, ref.Z/mr)\r\n                    dotu = max(min(ux.X*ur.X + ux.Y*ur.Y + ux.Z*ur.Z, 1.0), -1.0)\r\n                    ang = math.acos(dotu)\r\n                    cross = XYZ(ur.Y*ux.Z - ur.Z*ux.Y, ur.Z*ux.X - ur.X*ux.Z, ur.X*ux.Y - ur.Y*ux.X)\r\n                    sgn = cross.X*bz.X + cross.Y*bz.Y + cross.Z*bz.Z\r\n                    if sgn < 0: ang = -ang\r\n                    roll = ang_deg(ang)\r\n                    src.append(\"Roll:Tr.Bases\")\r\n                else:\r\n                    src.append(\"Roll:0ref\")\r\n            else:\r\n                src.append(\"Roll:0proj\")\r\n        else:\r\n            src.append(\"Roll:0\")\r\n    except:\r\n        src.append(\"Roll:0ex\")\r\n\r\n    return yaw, pitch, roll, \"+\".join(src)\r\n\r\ndef ifc_guid(e):\r\n    # IFC GUID oder Fallback UniqueId\r\n    try:\r\n        from Autodesk.Revit.DB import ExporterIFCUtils\r\n        g = ExporterIFCUtils.CreateGUID(e.Id)\r\n        if g: return g\r\n    except: pass\r\n    for pname in (\"IFC GUID\",\"IfcGUID\",\"IFCGUID\",\"IFCGlobalId\"):\r\n        try:\r\n            p = e.LookupParameter(pname)\r\n            if p and p.StorageType == StorageType.String:\r\n                v = p.AsString()\r\n                if v: return v\r\n        except: pass\r\n    try:\r\n        return e.UniqueId\r\n    except:\r\n        try:\r\n            return str(e.Id.IntegerValue)\r\n        except:\r\n            return \"UNKNOWN\"\r\n\r\n# -------- run ----------\r\nraw = flatten(IN[0])\r\ndb_elems = [to_db(x) for x in raw if x is not None and not isinstance(x, ElementType)]\r\n\r\nguids  = []\r\npoints = []\r\nyaws   = []\r\npitchs = []\r\nrolls  = []\r\nsources= []\r\n\r\nfor e in db_elems:\r\n    try:\r\n        guids.append(ifc_guid(e))\r\n        points.append(midpoint(e))\r\n        y, p, r, s = rotation_ypr_with_source(e)\r\n        yaws.append(y); pitchs.append(p); rolls.append(r); sources.append(s)\r\n    except Exception as ex:\r\n        # Element-spezifischer Fehler → nicht alles auf null reißen\r\n        guids.append(\"ERR\")\r\n        points.append(None)\r\n        yaws.append(0.0); pitchs.append(0.0); rolls.append(0.0)\r\n        sources.append(\"ERROR:\"+str(ex))\r\n\r\nOUT = [guids, points, yaws, pitchs, rolls, sources]\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "485e7d07215f43adb5eba6e8c424b311",
